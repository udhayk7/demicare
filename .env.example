# Dementia Care Companion - Frontend Environment Configuration

# -------------------------------------------------------------
# Local Development (Mac localhost):
# -------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
# Alternatively: VITE_API_URL=http://127.0.0.1:8000/api/v1

# -------------------------------------------------------------
# Physical Mobile LAN Testing (Same Wi-Fi Network):
# -------------------------------------------------------------
# Replace <MAC_LAN_IP> with the IP obtained via `ipconfig getifaddr en0`
# Example: VITE_API_BASE_URL=http://192.168.1.25:8000
# (Note: If left unset, the frontend will automatically connect to
# http://<hostname>:8000 when loaded on a mobile device)
# VITE_API_BASE_URL=http://<MAC_LAN_IP>:8000

# -------------------------------------------------------------
# Hackathon Demo Mode Configuration
# -------------------------------------------------------------
# Set to 'true' for automatic demo login
# Set to 'false' in production environments to require explicit manual login
VITE_DEMO_MODE=true

# Demo Credentials (ONLY used when VITE_DEMO_MODE=true)
VITE_DEMO_CAREGIVER_EMAIL=anu.menon@carecompanion.in
VITE_DEMO_CAREGIVER_PASSWORD=password123
